# Whisper Gateway URL.
# Inside docker-compose on infra-net the container resolves the gateway at
# http://whisper-gateway:5000. From the host machine the gateway is published
# on port 5148 (see the gateway's compose file), so local dev should use that.
WHISPER_GATEWAY_URL=http://100.79.146.102:5148

# Ollama Configuration
OLLAMA_URL=http://100.79.146.102:11434
OLLAMA_MODEL=gemma4:e4b
